# Fastlane Fastfile
# https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  desc "Run all tests"
  lane :test do
    scan(
      project: "WhisperBoard.xcodeproj",
      scheme: "WhisperBoard",
      device: "iPhone 15",
      clean: true
    )
  end

  desc "Build the app"
  lane :build do
    gym(
      project: "WhisperBoard.xcodeproj",
      scheme: "WhisperBoard",
      export_method: "development",
      output_directory: "build",
      build_path: "build"
    )
  end

  desc "Deploy to TestFlight (Beta)"
  lane :beta do
    key_id      = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id   = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

    # Temporary, unlocked, default CI keychain to hold the distribution identity.
    setup_ci

    # Import the reusable Apple Distribution cert (.p12), decoded from a secret by the
    # workflow. Apple's CLOUD-managed distribution signing does NOT work via API-key auth
    # ("Cloud signing permission error"), so the App-Store EXPORT is signed MANUALLY with
    # this real cert + the App Store profiles created below.
    import_certificate(
      certificate_path: ENV.fetch("DIST_CERT_P12_PATH"),
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    )

    # Write the .p8 so xcodebuild -allowProvisioningUpdates can authenticate for the
    # AUTOMATIC, development-signed ARCHIVE step (needs the registered device).
    require "fileutils"
    keys_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(keys_dir)
    key_path = File.join(keys_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, key_content)
    auth_args = "-allowProvisioningUpdates " \
                "-authenticationKeyPath #{key_path} " \
                "-authenticationKeyID #{key_id} " \
                "-authenticationKeyIssuerID #{issuer_id}"

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      in_house: false
    )

    # App Store provisioning profiles (App Store type needs NO registered devices). Fixed
    # names so the export mapping is exact; force:true rebinds them to the current cert.
    app_prof = "WhisperBoard AppStore CI"
    kb_prof  = "WhisperBoard Keyboard AppStore CI"
    sigh(api_key: api_key, app_identifier: "com.captainsos.whisperboard",
         provisioning_name: app_prof, force: true)
    sigh(api_key: api_key, app_identifier: "com.captainsos.whisperboard.keyboard",
         provisioning_name: kb_prof, force: true)

    # Monotonic build number from the CI run (XcodeGen regenerates the project each run).
    increment_build_number(
      xcodeproj: "WhisperBoard.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    # Archive with automatic development signing (device-backed), then MANUALLY re-sign the
    # App-Store export with the imported distribution cert + the profiles above.
    gym(
      project: "WhisperBoard.xcodeproj",
      scheme: "WhisperBoard",
      export_method: "app-store",
      output_directory: "build",
      build_path: "build",
      include_bitcode: false,
      include_symbols: true,
      xcargs: auth_args,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.captainsos.whisperboard"          => app_prof,
          "com.captainsos.whisperboard.keyboard" => kb_prof
        }
      }
    )

    # Upload to TestFlight via the API key. skip_waiting=true → don't block CI on Apple
    # processing; the build shows up in TestFlight a few minutes after upload.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.captainsos.whisperboard",
      ipa: "build/WhisperBoard.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )

    clean_build_artifacts

    UI.success("🎉 Successfully deployed to TestFlight!")
  end

  desc "Deploy to App Store (Production)"
  lane :release do
    # Run tests first
    test

    # Increment version number
    increment_version_number(
      xcodeproj: "WhisperBoard.xcodeproj"
    )

    # Build and sign the app
    gym(
      project: "WhisperBoard.xcodeproj",
      scheme: "WhisperBoard",
      export_method: "app-store",
      output_directory: "build"
    )

    # Upload to App Store
    deliver(
      ipa: "build/WhisperBoard.ipa",
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false
    )

    UI.success("🎉 Successfully deployed to App Store Connect!")
  end

  desc "Sync code signing certificates"
  lane :sync_certs do
    match(
      type: "appstore",
      app_identifier: "com.captainsos.whisperboard",
      readonly: true
    )
  end

  desc "Setup code signing for new machine"
  lane :setup_certs do
    match(
      type: "development",
      app_identifier: "com.captainsos.whisperboard"
    )
    match(
      type: "appstore",
      app_identifier: "com.captainsos.whisperboard"
    )
  end

  desc "Take screenshots for App Store"
  lane :screenshots do
    capture_screenshots(
      project: "WhisperBoard.xcodeproj",
      scheme: "WhisperBoardUITests",
      output_directory: "fastlane/screenshots"
    )
  end

end
