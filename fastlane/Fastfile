# Fastlane Fastfile
# https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  desc "Run all tests"
  lane :test do
    scan(
      project: "WhisperBoard.xcodeproj",
      scheme: "WhisperBoard",
      device: "iPhone 15",
      clean: true
    )
  end

  desc "Build the app"
  lane :build do
    gym(
      project: "WhisperBoard.xcodeproj",
      scheme: "WhisperBoard",
      export_method: "development",
      output_directory: "build",
      build_path: "build"
    )
  end

  desc "Deploy to TestFlight (Beta)"
  lane :beta do
    key_id      = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id   = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

    # Write the .p8 to the conventional path so `xcodebuild -allowProvisioningUpdates`
    # can authenticate to Apple and CREATE the cloud-managed distribution cert +
    # provisioning profiles. Without -authenticationKey*, xcodebuild reports
    # "No Accounts" and "No profiles were found" (the first-run failure we hit).
    require "fileutils"
    keys_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(keys_dir)
    key_path = File.join(keys_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, key_content)
    auth_args = "-allowProvisioningUpdates " \
                "-authenticationKeyPath #{key_path} " \
                "-authenticationKeyID #{key_id} " \
                "-authenticationKeyIssuerID #{issuer_id}"

    # API key object for fastlane's own Apple API calls (upload_to_testflight).
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      in_house: false
    )

    # Monotonic build number from the CI run. The .xcodeproj is regenerated by XcodeGen
    # every run, so the committed value is irrelevant — we set it explicitly here.
    increment_build_number(
      xcodeproj: "WhisperBoard.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    # Build + sign with Xcode cloud-managed AUTOMATIC signing. The explicit auth args
    # (on BOTH archive via xcargs and export via export_xcargs) give xcodebuild the
    # account it needs to auto-provision the app AND the keyboard extension.
    gym(
      project: "WhisperBoard.xcodeproj",
      scheme: "WhisperBoard",
      export_method: "app-store",
      output_directory: "build",
      build_path: "build",
      include_bitcode: false,
      include_symbols: true,
      # Archive step: gym does NOT auto-add the API-key auth, so we pass it here.
      # Export step: gym auto-injects the same auth from app_store_connect_api_key,
      # so we must NOT pass export_xcargs (duplicate -authenticationKeyPath = error).
      xcargs: auth_args,
      export_options: {
        signingStyle: "automatic"
      }
    )

    # Upload to TestFlight via the API key. skip_waiting=true → don't block CI on Apple
    # processing; the build shows up in TestFlight a few minutes after upload.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.captainsos.whisperboard",
      ipa: "build/WhisperBoard.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )

    clean_build_artifacts

    UI.success("🎉 Successfully deployed to TestFlight!")
  end

  desc "Deploy to App Store (Production)"
  lane :release do
    # Run tests first
    test

    # Increment version number
    increment_version_number(
      xcodeproj: "WhisperBoard.xcodeproj"
    )

    # Build and sign the app
    gym(
      project: "WhisperBoard.xcodeproj",
      scheme: "WhisperBoard",
      export_method: "app-store",
      output_directory: "build"
    )

    # Upload to App Store
    deliver(
      ipa: "build/WhisperBoard.ipa",
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false
    )

    UI.success("🎉 Successfully deployed to App Store Connect!")
  end

  desc "Sync code signing certificates"
  lane :sync_certs do
    match(
      type: "appstore",
      app_identifier: "com.captainsos.whisperboard",
      readonly: true
    )
  end

  desc "Setup code signing for new machine"
  lane :setup_certs do
    match(
      type: "development",
      app_identifier: "com.captainsos.whisperboard"
    )
    match(
      type: "appstore",
      app_identifier: "com.captainsos.whisperboard"
    )
  end

  desc "Take screenshots for App Store"
  lane :screenshots do
    capture_screenshots(
      project: "WhisperBoard.xcodeproj",
      scheme: "WhisperBoardUITests",
      output_directory: "fastlane/screenshots"
    )
  end

end
